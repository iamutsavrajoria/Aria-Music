+                    TextButton(onClick = { engine.move(i, i - 1) }, enabled = i > 0) { Text("Up") }
+                    TextButton(onClick = { engine.move(i, i + 1) }, enabled = i < state.queue.lastIndex) { Text("Down") }
+                    TextButton(onClick = { engine.removeAt(i) }) { Text("Remove") }
+                }
+            }
+        }
+    }
+}
