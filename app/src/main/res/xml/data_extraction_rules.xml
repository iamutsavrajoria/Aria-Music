<?xml version="1.0" encoding="utf-8"?>
<!-- Same exclusions as backup_rules.xml, for Android 12+ cloud backup and device transfer. See that file. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="secure/" />
        <exclude domain="sharedpref" path="secure.xml" />
        <exclude domain="database" path="aria.db" />
        <exclude domain="database" path="aria.db-wal" />
        <exclude domain="database" path="aria.db-shm" />
        <exclude domain="database" path="aria.db-journal" />
        <exclude domain="sharedpref" path="resume.xml" />
        <exclude domain="file" path="crash/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="secure/" />
        <exclude domain="sharedpref" path="secure.xml" />
        <exclude domain="database" path="aria.db" />
        <exclude domain="database" path="aria.db-wal" />
        <exclude domain="database" path="aria.db-shm" />
        <exclude domain="database" path="aria.db-journal" />
        <exclude domain="sharedpref" path="resume.xml" />
        <exclude domain="file" path="crash/" />
    </device-transfer>
</data-extraction-rules>
